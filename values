{
  "settings": { "game": "My game", "currency": "Coins" },
  "items": [
    { "id": "s1", "name": "Sample Crown", "value": 12500, "demand": 4, "trend": "Rising", "copies": 85, "note": "Sample item", "image": "", "added": 5, "sample": true },
    { "id": "s2", "name": "Sample Wings", "value": 4800, "demand": 3, "trend": "Stable", "copies": 410, "note": "Sample item", "image": "", "added": 4, "sample": true },
    { "id": "s3", "name": "Sample Mask", "value": 950, "demand": 2, "trend": "Falling", "copies": 2300, "note": "Sample item", "image": "", "added": 3, "sample": true },
    { "id": "s4", "name": "Sample Halo", "value": 31000, "demand": 4, "trend": "Rising", "copies": 22, "note": "Sample item", "image": "", "added": 2, "sample": true },
    { "id": "s5", "name": "Sample Scarf", "value": 120, "demand": 0, "trend": "Falling", "copies": 9800, "note": "Sample item", "image": "", "added": 1, "sample": true }
  ]
}

(() => {
'use strict';

const KEY = 'limited-values-v1';
const DEMANDS = ['Terrible', 'Low', 'Normal', 'Good', 'Amazing'];
const TRENDS = ['Rising', 'Stable', 'Falling'];
const TREND_MARK = { Rising: '▲', Stable: '■', Falling: '▼' };
const TREND_RANK = { Rising: 0, Stable: 1, Falling: 2 };

const $ = s => document.querySelector(s);
const clone = o => JSON.parse(JSON.stringify(o));
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const uid = () => (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2));
const fmt = n => Number(n).toLocaleString();

const FALLBACK = {
  settings: { game: 'My game', currency: 'Coins' },
  items: [
    { id: 's1', name: 'Sample Crown', value: 12500, demand: 4, trend: 'Rising', copies: 85, note: 'Sample item', image: '', added: 5, sample: true },
    { id: 's2', name: 'Sample Wings', value: 4800, demand: 3, trend: 'Stable', copies: 410, note: 'Sample item', image: '', added: 4, sample: true },
    { id: 's3', name: 'Sample Mask', value: 950, demand: 2, trend: 'Falling', copies: 2300, note: 'Sample item', image: '', added: 3, sample: true },
    { id: 's4', name: 'Sample Halo', value: 31000, demand: 4, trend: 'Rising', copies: 22, note: 'Sample item', image: '', added: 2, sample: true },
    { id: 's5', name: 'Sample Scarf', value: 120, demand: 0, trend: 'Falling', copies: 9800, note: 'Sample item', image: '', added: 1, sample: true }
  ]
};

let saved = null;      // what is stored
let draft = null;      // what is on screen, including unsaved edits
let editingId = null;
let pendingImage = '';

/* ---------- data ---------- */

function clean(data) {
  if (!data || !Array.isArray(data.items)) throw new Error('Not a values file');
  const s = data.settings || {};
  return {
    settings: {
      game: String(s.game ?? 'My game').slice(0, 60),
      currency: String(s.currency ?? 'Coins').slice(0, 20)
    },
    items: data.items.map((it, i) => ({
      id: String(it.id || uid()),
      name: String(it.name || 'Unnamed').slice(0, 80),
      value: Math.max(0, Number(it.value) || 0),
      demand: Math.min(4, Math.max(0, Number(it.demand) || 0)),
      trend: TRENDS.includes(it.trend) ? it.trend : 'Stable',
      copies: Math.max(0, Math.floor(Number(it.copies) || 0)),
      note: String(it.note || '').slice(0, 140),
      image: typeof it.image === 'string' && it.image.startsWith('data:image/') ? it.image : '',
      added: Number(it.added) || i,
      sample: !!it.sample
    }))
  };
}

async function load() {
  try {
    const s = localStorage.getItem(KEY);
    if (s) return clean(JSON.parse(s));
  } catch (e) { /* fall through */ }
  try {
    const r = await fetch('values.json', { cache: 'no-cache' });
    if (r.ok) return clean(await r.json());
  } catch (e) { /* fall through */ }
  return clean(FALLBACK);
}

const isDirty = () => JSON.stringify(saved) !== JSON.stringify(draft);

/* ---------- render ---------- */

function sorted(items) {
  const q = $('#search').value.trim().toLowerCase();
  const list = items.filter(i => i.name.toLowerCase().includes(q));
  const by = $('#sort').value;
  const cmp = {
    'value-desc': (a, b) => b.value - a.value,
    'value-asc': (a, b) => a.value - b.value,
    demand: (a, b) => b.demand - a.demand || b.value - a.value,
    trend: (a, b) => TREND_RANK[a.trend] - TREND_RANK[b.trend] || b.value - a.value,
    'copies-asc': (a, b) => a.copies - b.copies,
    name: (a, b) => a.name.localeCompare(b.name),
    new: (a, b) => b.added - a.added
  }[by];
  return list.sort(cmp);
}

function rowHTML(it, currency) {
  const thumb = it.image
    ? `<img src="${esc(it.image)}" alt="">`
    : esc(it.name.trim().charAt(0).toUpperCase() || '?');
  const meter = [0, 1, 2, 3, 4].map(n => `<i class="${n <= it.demand ? 'on' : ''}"></i>`).join('');
  return `
  <article class="row" data-id="${esc(it.id)}">
    <div class="thumb">${thumb}</div>
    <div class="name">
      <h3>${esc(it.name)}</h3>
      ${it.note ? `<p class="note">${esc(it.note)}</p>` : ''}
    </div>
    <div class="value"><strong>${fmt(it.value)}</strong><span>${esc(currency)}</span></div>
    <div class="demand"><div class="meter" aria-hidden="true">${meter}</div><span>Demand: ${DEMANDS[it.demand]}</span></div>
    <div class="trend ${it.trend.toLowerCase()}">${TREND_MARK[it.trend]} ${it.trend}</div>
    <div class="copies"><strong>${fmt(it.copies)}</strong> <span>copies</span></div>
    <div class="rowtools">
      <button type="button" class="btn small ghost" data-act="edit">Edit</button>
      <button type="button" class="btn small ghost" data-act="delete">Delete</button>
    </div>
  </article>`;
}

function render() {
  $('#gameName').textContent = draft.settings.game;
  document.title = `${draft.settings.game} · Limited Values`;

  const list = sorted(draft.items);
  $('#list').innerHTML = list.length
    ? list.map(i => rowHTML(i, draft.settings.currency)).join('')
    : `<p class="state"><strong>${draft.items.length ? 'No matches' : 'No limiteds yet'}</strong><br>${
        draft.items.length ? 'Try a different name.' : 'Choose Edit values, then add your first limited.'}</p>`;

  $('#samplesNote').hidden = !draft.items.some(i => i.sample);
  $('#savebar').hidden = !isDirty();
}

/* ---------- editor ---------- */

function fillSelects() {
  $('#fDemand').innerHTML = DEMANDS.map((d, i) => `<option value="${i}">${d}</option>`).join('');
  $('#fTrend').innerHTML = TRENDS.map(t => `<option>${t}</option>`).join('');
}

function showPreview() {
  const p = $('#picPreview');
  p.innerHTML = pendingImage ? `<img src="${esc(pendingImage)}" alt="">` : '';
  $('#picClear').hidden = !pendingImage;
}

function resetForm() {
  editingId = null;
  pendingImage = '';
  $('#itemForm').reset();
  $('#fPic').value = '';
  $('#formTitle').textContent = 'Add a limited';
  $('#formSubmit').textContent = 'Add limited';
  $('#formCancel').hidden = true;
  showPreview();
}

function startEdit(id) {
  const it = draft.items.find(i => i.id === id);
  if (!it) return;
  editingId = id;
  $('#fName').value = it.name;
  $('#fValue').value = it.value;
  $('#fDemand').value = it.demand;
  $('#fTrend').value = it.trend;
  $('#fCopies').value = it.copies;
  $('#fNote').value = it.note;
  pendingImage = it.image;
  showPreview();
  $('#formTitle').textContent = 'Edit limited';
  $('#formSubmit').textContent = 'Update limited';
  $('#formCancel').hidden = false;
  $('#formTitle').scrollIntoView({ behavior: 'smooth', block: 'start' });
  $('#fName').focus({ preventScroll: true });
}

function shrinkImage(file) {
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      const size = 192;
      const scale = Math.max(size / img.width, size / img.height);
      const w = img.width * scale, h = img.height * scale;
      const c = document.createElement('canvas');
      c.width = c.height = size;
      c.getContext('2d').drawImage(img, (size - w) / 2, (size - h) / 2, w, h);
      URL.revokeObjectURL(url);
      resolve(c.toDataURL('image/jpeg', 0.82));
    };
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('Not an image')); };
    img.src = url;
  });
}

/* ---------- events ---------- */

$('#editToggle').addEventListener('click', () => {
  const on = document.body.classList.toggle('editing');
  $('#editor').hidden = !on;
  $('#editToggle').setAttribute('aria-expanded', on);
  $('#editToggle').textContent = on ? 'Done editing' : 'Edit values';
});

$('#search').addEventListener('input', render);
$('#sort').addEventListener('change', render);

$('#setGame').addEventListener('input', e => { draft.settings.game = e.target.value; render(); });
$('#setCurrency').addEventListener('input', e => { draft.settings.currency = e.target.value; render(); });

$('#fPic').addEventListener('change', async e => {
  const f = e.target.files[0];
  if (!f) return;
  try { pendingImage = await shrinkImage(f); showPreview(); }
  catch { alert('That file could not be read as a picture. Choose a PNG, JPG or WebP image.'); e.target.value = ''; }
});
$('#picClear').addEventListener('click', () => { pendingImage = ''; $('#fPic').value = ''; showPreview(); });

$('#itemForm').addEventListener('submit', e => {
  e.preventDefault();
  const base = {
    name: $('#fName').value.trim(),
    value: Math.max(0, Number($('#fValue').value) || 0),
    demand: Number($('#fDemand').value),
    trend: $('#fTrend').value,
    copies: Math.max(0, Math.floor(Number($('#fCopies').value) || 0)),
    note: $('#fNote').value.trim(),
    image: pendingImage
  };
  if (!base.name) return;
  if (editingId) {
    const i = draft.items.findIndex(x => x.id === editingId);
    draft.items[i] = { ...draft.items[i], ...base };
  } else {
    draft.items.push({ id: uid(), added: Date.now(), sample: false, ...base });
  }
  resetForm();
  render();
});
$('#formCancel').addEventListener('click', resetForm);

$('#list').addEventListener('click', e => {
  const btn = e.target.closest('[data-act]');
  if (!btn) return;
  const id = btn.closest('.row').dataset.id;
  if (btn.dataset.act === 'edit') startEdit(id);
  if (btn.dataset.act === 'delete') {
    draft.items = draft.items.filter(i => i.id !== id);
    if (editingId === id) resetForm();
    render();
  }
});

$('#removeSamples').addEventListener('click', () => {
  draft.items = draft.items.filter(i => !i.sample);
  render();
});

$('#saveBtn').addEventListener('click', () => {
  try {
    localStorage.setItem(KEY, JSON.stringify(draft));
    saved = clone(draft);
    render();
  } catch {
    alert('The changes could not be saved in this browser. Remove some pictures and try again, or export values.json to keep a copy.');
  }
});
$('#discardBtn').addEventListener('click', () => {
  draft = clone(saved);
  resetForm();
  syncSettings();
  render();
});

$('#exportBtn').addEventListener('click', () => {
  const blob = new Blob([JSON.stringify(draft, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'values.json';
  a.click();
  URL.revokeObjectURL(a.href);
});

$('#importFile').addEventListener('change', async e => {
  const f = e.target.files[0];
  if (!f) return;
  try {
    draft = clean(JSON.parse(await f.text()));
    resetForm();
    syncSettings();
    render();
  } catch {
    alert('That file is not a valid values.json. Export one from this page and try again.');
  }
  e.target.value = '';
});

$('#resetBtn').addEventListener('click', async () => {
  if (!confirm('Discard the values saved in this browser and load the published values.json?')) return;
  localStorage.removeItem(KEY);
  saved = await load();
  draft = clone(saved);
  resetForm();
  syncSettings();
  render();
});

window.addEventListener('beforeunload', e => {
  if (draft && isDirty()) { e.preventDefault(); e.returnValue = ''; }
});

function syncSettings() {
  $('#setGame').value = draft.settings.game;
  $('#setCurrency').value = draft.settings.currency;
}

/* ---------- start ---------- */

(async function init() {
  fillSelects();
  saved = await load();
  draft = clone(saved);
  syncSettings();
  render();
})();
})();

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Limited Values</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header class="top">
  <div>
    <p class="game" id="gameName"></p>
    <h1>Limited Values</h1>
  </div>
  <button type="button" id="editToggle" class="btn ghost" aria-expanded="false">Edit values</button>
</header>

<main>
  <div id="samplesNote" class="notice" hidden>
    <p>The five items below are samples so you can see the layout. Remove them before you share this page.</p>
    <button type="button" class="btn small" id="removeSamples">Remove samples</button>
  </div>

  <section class="tools" aria-label="Search and sort">
    <label class="field grow">
      <span>Search</span>
      <input type="search" id="search" placeholder="Item name">
    </label>
    <label class="field">
      <span>Sort by</span>
      <select id="sort">
        <option value="value-desc">Value, high to low</option>
        <option value="value-asc">Value, low to high</option>
        <option value="demand">Demand</option>
        <option value="trend">Trend</option>
        <option value="copies-asc">Copies, rarest first</option>
        <option value="name">Name, A to Z</option>
        <option value="new">Recently added</option>
      </select>
    </label>
  </section>

  <section id="list" aria-live="polite">
    <p class="state"><strong>Loading values</strong><br>One moment.</p>
  </section>

  <section id="editor" class="editor" hidden>
    <h2>Page settings</h2>
    <div class="form-grid">
      <label class="field">
        <span>Game name</span>
        <input type="text" id="setGame" maxlength="60">
      </label>
      <label class="field">
        <span>Currency label</span>
        <input type="text" id="setCurrency" maxlength="20">
      </label>
    </div>

    <h2 id="formTitle">Add a limited</h2>
    <form id="itemForm" class="form-grid" autocomplete="off">
      <label class="field wide">
        <span>Item name</span>
        <input type="text" id="fName" required maxlength="80">
      </label>
      <label class="field">
        <span>Value</span>
        <input type="number" id="fValue" required min="0" step="any" inputmode="decimal">
      </label>
      <label class="field">
        <span>Demand</span>
        <select id="fDemand"></select>
      </label>
      <label class="field">
        <span>Trend</span>
        <select id="fTrend"></select>
      </label>
      <label class="field">
        <span>Copies in circulation</span>
        <input type="number" id="fCopies" min="0" step="1" inputmode="numeric">
      </label>
      <label class="field wide">
        <span>Note (optional)</span>
        <input type="text" id="fNote" maxlength="140">
      </label>
      <div class="field wide">
        <span>Picture (optional)</span>
        <div class="pic-row">
          <div class="thumb" id="picPreview" aria-hidden="true"></div>
          <input type="file" id="fPic" accept="image/*">
          <button type="button" class="btn small ghost" id="picClear" hidden>Remove picture</button>
        </div>
      </div>
      <div class="actions wide">
        <button type="submit" class="btn" id="formSubmit">Add limited</button>
        <button type="button" class="btn ghost" id="formCancel" hidden>Cancel edit</button>
      </div>
    </form>

    <h2>Publish these values</h2>
    <p class="help">Changes you save stay in this browser only. To show them to everyone, export the file and upload it to your repository as <code>values.json</code>, replacing the old one.</p>
    <div class="actions">
      <button type="button" class="btn ghost" id="exportBtn">Export values.json</button>
      <label class="btn ghost file-btn">Import values.json<input type="file" id="importFile" accept="application/json,.json" hidden></label>
      <button type="button" class="btn ghost" id="resetBtn">Reset to published values</button>
    </div>
  </section>
</main>

<div id="savebar" class="savebar" role="status" hidden>
  <p>You have unsaved changes.</p>
  <div class="actions">
    <button type="button" class="btn ghost light" id="discardBtn">Discard changes</button>
    <button type="button" class="btn light solid" id="saveBtn">Save changes</button>
  </div>
</div>

<script src="app.js"></script>
</body>
</html>

:root{
  --bg:#e9edf5;
  --panel:#ffffff;
  --ink:#161b2e;
  --muted:#5a6379;
  --line:#d3d9e6;
  --accent:#3b2fd1;
  --accent-soft:#e6e4fb;
  --up:#0e8a5f;
  --down:#c23b3b;
  --flat:#6b7388;
  --display:"Bricolage Grotesque","Trebuchet MS",system-ui,sans-serif;
  --body:"Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme:dark){
  :root{
    --bg:#0f1322;
    --panel:#181d31;
    --ink:#eef0f8;
    --muted:#9aa3bb;
    --line:#2a3150;
    --accent:#8b82ff;
    --accent-soft:#25244d;
    --up:#3ecf97;
    --down:#ff7b7b;
    --flat:#9aa3bb;
  }
}
*{box-sizing:border-box}
html{background:var(--bg)}
body{
  margin:0;
  font:400 1rem/1.5 var(--body);
  color:var(--ink);
  background:var(--bg);
  padding-bottom:6rem;
}
main,.top{max-width:68rem;margin:0 auto;padding-inline:1.25rem}
.top{
  display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;
  padding-top:2.5rem;padding-bottom:1.5rem;
}
.game{margin:0;color:var(--muted);font-weight:500}
h1{
  margin:0;
  font:800 clamp(2.4rem,7vw,4.5rem)/0.95 var(--display);
  letter-spacing:-0.03em;
}
h2{font:800 1.25rem/1.2 var(--display);margin:2rem 0 1rem}

:focus-visible{outline:3px solid var(--accent);outline-offset:2px}

/* buttons */
.btn{
  font:600 0.95rem/1 var(--body);
  padding:0.8rem 1.1rem;
  border-radius:999px;
  border:2px solid var(--accent);
  background:var(--accent);
  color:#fff;
  cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;
}
.btn.ghost{background:transparent;color:var(--accent)}
.btn.small{padding:0.5rem 0.8rem;font-size:0.85rem}
.btn:hover{filter:brightness(1.08)}
@media (prefers-color-scheme:dark){.btn:not(.ghost){color:#10122a}}

/* notice */
.notice{
  display:flex;gap:1rem;align-items:center;justify-content:space-between;flex-wrap:wrap;
  background:var(--accent-soft);
  border-radius:14px;
  padding:0.9rem 1.1rem;
  margin-bottom:1.25rem;
}
.notice p{margin:0}

/* tools */
.tools{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1.25rem}
.field{display:flex;flex-direction:column;gap:0.35rem;min-width:0}
.field>span{font-size:0.85rem;font-weight:600;color:var(--muted)}
.field.grow{flex:1 1 14rem}
input,select{
  font:inherit;color:var(--ink);
  background:var(--panel);
  border:2px solid var(--line);
  border-radius:10px;
  padding:0.65rem 0.8rem;
  width:100%;
}
input[type=file]{padding:0.5rem;border-style:dashed}

/* rows */
#list{display:flex;flex-direction:column;gap:0.6rem}
.row{
  display:grid;
  grid-template-columns:3.5rem minmax(0,1fr) 9rem 8rem 7rem 6rem;
  align-items:center;
  gap:1rem;
  background:var(--panel);
  border-radius:16px;
  padding:0.8rem 1rem;
}
.thumb{
  width:3.5rem;height:3.5rem;border-radius:10px;
  background:var(--accent-soft);
  color:var(--accent);
  display:grid;place-items:center;
  font:800 1.2rem var(--display);
  overflow:hidden;
  flex:none;
}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.name h3{margin:0;font:600 1.05rem/1.25 var(--body);overflow-wrap:anywhere}
.note{margin:0.15rem 0 0;color:var(--muted);font-size:0.9rem;overflow-wrap:anywhere}
.value{text-align:right}
.value strong{
  display:block;
  font:800 1.9rem/1 var(--display);
  letter-spacing:-0.02em;
  font-variant-numeric:tabular-nums;
}
.value span,.copies span{font-size:0.8rem;color:var(--muted)}
.demand{display:flex;flex-direction:column;gap:0.35rem}
.meter{display:flex;gap:3px}
.meter i{flex:1;height:8px;border-radius:3px;background:var(--line)}
.meter i.on{background:var(--accent)}
.demand span{font-size:0.85rem;font-weight:500}
.trend{font-weight:600;font-size:0.95rem}
.trend.rising{color:var(--up)}
.trend.falling{color:var(--down)}
.trend.stable{color:var(--flat)}
.copies{text-align:right}
.copies strong{display:block;font-variant-numeric:tabular-nums}
.rowtools{display:none;grid-column:2/-1;gap:0.5rem}
body.editing .rowtools{display:flex}

.state{
  background:var(--panel);border-radius:16px;
  padding:2rem 1.25rem;text-align:center;color:var(--muted);margin:0;
}
.state strong{color:var(--ink)}

@media (max-width:52rem){
  .row{grid-template-columns:3.5rem minmax(0,1fr) auto;row-gap:0.7rem}
  .demand{grid-column:1/3}
  .trend{grid-column:3;text-align:right}
  .copies{grid-column:1/3;text-align:left}
  .copies strong,.copies span{display:inline}
  .value{grid-column:3;grid-row:1}
  .rowtools{grid-column:1/-1}
}

/* editor */
.editor{
  margin-top:2.5rem;
  background:var(--panel);
  border-radius:20px;
  padding:0.5rem 1.5rem 1.75rem;
}
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:1rem}
.wide{grid-column:1/-1}
.pic-row{display:flex;gap:1rem;align-items:center;flex-wrap:wrap}
.pic-row input{width:auto;flex:1 1 14rem}
.actions{display:flex;gap:0.6rem;flex-wrap:wrap}
.help{color:var(--muted);margin:0 0 1rem;max-width:60ch}
code{background:var(--accent-soft);padding:0.1rem 0.4rem;border-radius:6px}
.file-btn{cursor:pointer}

/* save bar */
.savebar{
  position:fixed;left:0;right:0;bottom:0;
  background:var(--ink);color:var(--bg);
  display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;
  padding:0.9rem 1.25rem;
}
.savebar p{margin:0;font-weight:600}
.btn.light{border-color:var(--bg);color:var(--bg);background:transparent}
.btn.light.solid{background:var(--bg);color:var(--ink)}
[hidden]{display:none!important}
